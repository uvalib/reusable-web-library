{
  "name": "@uvalib/web-components",
  "version": "0.0.0",
  "description": "UVA Library reusable web components",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "wtr \"test/**/*.test.ts\" --config web-test-runner.config.mjs",
    "lint": "eslint . && prettier --check .",
    "build:npm": "tsc -p tsconfig.build.json",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\" --outdir dist"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}

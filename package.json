{
  "name": "@uvalib/web-components",
  "version": "0.0.0",
  "description": "UVA Library reusable web components",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/components/*/site-*.js",
    "./src/components/*/site-*.ts",
    "*.css"
  ],
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.js": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./site-page.js": {
      "types": "./dist/components/site-page/site-page.d.ts",
      "default": "./dist/components/site-page/site-page.js"
    },
    "./site-header.js": {
      "types": "./dist/components/site-header/site-header.d.ts",
      "default": "./dist/components/site-header/site-header.js"
    },
    "./site-footer.js": {
      "types": "./dist/components/site-footer/site-footer.d.ts",
      "default": "./dist/components/site-footer/site-footer.js"
    },
    "./site-analytics.js": {
      "types": "./dist/components/site-analytics/site-analytics.d.ts",
      "default": "./dist/components/site-analytics/site-analytics.js"
    },
    "./site-style.js": {
      "types": "./dist/components/site-style/site-style.d.ts",
      "default": "./dist/components/site-style/site-style.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./manifest.json": "./dist-cdn/manifest.json",
    "./skills/*": "./skills/*"
  },
  "bin": {
    "uvalib-web-components": "bin/install-skill.mjs"
  },
  "files": [
    "dist",
    "dist-cdn",
    "skills",
    "bin",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "pnpm build && pnpm build:site --base /dist-site/ && pnpm test:node && pnpm test:browser",
    "test:node": "node --test test/*.test.mjs",
    "test:browser": "wtr \"test/**/*.test.ts\" --config web-test-runner.config.mjs",
    "lint": "eslint . && prettier --check .",
    "build:npm": "tsc -p tsconfig.build.json && node scripts/emit-css.mjs dist && pnpm analyze && node scripts/gen-reference.mjs",
    "release": "node scripts/release.mjs",
    "build": "pnpm build:npm && pnpm build:cdn",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\" --outdir dist",
    "build:cdn": "vite build && node scripts/emit-css.mjs dist-cdn && node -e \"require('fs').copyFileSync('dist/custom-elements.json','dist-cdn/custom-elements.json')\" && node scripts/build-manifest.mjs && node scripts/copy-skills.mjs",
    "build:site": "vite build -c vite.site.config.ts",
    "start": "vite -c vite.site.config.ts --open /site/"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.0.2",
    "@web/test-runner-playwright": "^1.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "playground-elements": "^0.21.2",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}

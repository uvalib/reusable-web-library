{
  "name": "@uvalib/web-components",
  "version": "1.2.0",
  "description": "UVA Library reusable web components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvalib/reusable-web-library.git"
  },
  "homepage": "https://uvalib.github.io/reusable-web-library/",
  "bugs": {
    "url": "https://github.com/uvalib/reusable-web-library/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/components/*/site-*.js",
    "./dist/components/*/uvalib-*.js",
    "./dist/components/*/library-*.js",
    "./dist/components/events-section/events-section.js",
    "./dist/components/bento-box/bento-box.js",
    "./src/components/*/site-*.ts",
    "./src/components/*/uvalib-*.ts",
    "./src/components/*/library-*.ts",
    "./src/components/events-section/events-section.ts",
    "./src/components/bento-box/bento-box.ts",
    "*.css"
  ],
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.js": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./site-page.js": {
      "types": "./dist/components/site-page/site-page.d.ts",
      "default": "./dist/components/site-page/site-page.js"
    },
    "./site-header.js": {
      "types": "./dist/components/site-header/site-header.d.ts",
      "default": "./dist/components/site-header/site-header.js"
    },
    "./site-main-nav.js": {
      "types": "./dist/components/site-main-nav/site-main-nav.d.ts",
      "default": "./dist/components/site-main-nav/site-main-nav.js"
    },
    "./site-footer.js": {
      "types": "./dist/components/site-footer/site-footer.d.ts",
      "default": "./dist/components/site-footer/site-footer.js"
    },
    "./site-analytics.js": {
      "types": "./dist/components/site-analytics/site-analytics.d.ts",
      "default": "./dist/components/site-analytics/site-analytics.js"
    },
    "./uvalib-analytics.js": {
      "types": "./dist/components/uvalib-analytics/uvalib-analytics.d.ts",
      "default": "./dist/components/uvalib-analytics/uvalib-analytics.js"
    },
    "./site-style.js": {
      "types": "./dist/components/site-style/site-style.d.ts",
      "default": "./dist/components/site-style/site-style.js"
    },
    "./uvalib-filter.js": {
      "types": "./dist/components/uvalib-filter/uvalib-filter.d.ts",
      "default": "./dist/components/uvalib-filter/uvalib-filter.js"
    },
    "./uvalib-date-range.js": {
      "types": "./dist/components/uvalib-date-range/uvalib-date-range.d.ts",
      "default": "./dist/components/uvalib-date-range/uvalib-date-range.js"
    },
    "./uvalib-date-histogram.js": {
      "types": "./dist/components/uvalib-date-histogram/uvalib-date-histogram.d.ts",
      "default": "./dist/components/uvalib-date-histogram/uvalib-date-histogram.js"
    },
    "./uvalib-breadcrumbs.js": {
      "types": "./dist/components/uvalib-breadcrumbs/uvalib-breadcrumbs.d.ts",
      "default": "./dist/components/uvalib-breadcrumbs/uvalib-breadcrumbs.js"
    },
    "./uvalib-card.js": {
      "types": "./dist/components/uvalib-card/uvalib-card.d.ts",
      "default": "./dist/components/uvalib-card/uvalib-card.js"
    },
    "./uvalib-card-grid.js": {
      "types": "./dist/components/uvalib-card-grid/uvalib-card-grid.d.ts",
      "default": "./dist/components/uvalib-card-grid/uvalib-card-grid.js"
    },
    "./uvalib-pager.js": {
      "types": "./dist/components/uvalib-pager/uvalib-pager.d.ts",
      "default": "./dist/components/uvalib-pager/uvalib-pager.js"
    },
    "./uvalib-contents.js": {
      "types": "./dist/components/uvalib-contents/uvalib-contents.d.ts",
      "default": "./dist/components/uvalib-contents/uvalib-contents.js"
    },
    "./uvalib-metadata.js": {
      "types": "./dist/components/uvalib-metadata/uvalib-metadata.d.ts",
      "default": "./dist/components/uvalib-metadata/uvalib-metadata.js"
    },
    "./uvalib-pagefind-search.js": {
      "types": "./dist/components/uvalib-pagefind-search/uvalib-pagefind-search.d.ts",
      "default": "./dist/components/uvalib-pagefind-search/uvalib-pagefind-search.js"
    },
    "./uvalib-lightbox.js": {
      "types": "./dist/components/uvalib-lightbox/uvalib-lightbox.d.ts",
      "default": "./dist/components/uvalib-lightbox/uvalib-lightbox.js"
    },
    "./uvalib-photo-grid.js": {
      "types": "./dist/components/uvalib-photo-grid/uvalib-photo-grid.d.ts",
      "default": "./dist/components/uvalib-photo-grid/uvalib-photo-grid.js"
    },
    "./uvalib-chip-group.js": {
      "types": "./dist/components/uvalib-chip-group/uvalib-chip-group.d.ts",
      "default": "./dist/components/uvalib-chip-group/uvalib-chip-group.js"
    },
    "./uvalib-tag-list.js": {
      "types": "./dist/components/uvalib-tag-list/uvalib-tag-list.d.ts",
      "default": "./dist/components/uvalib-tag-list/uvalib-tag-list.js"
    },
    "./uvalib-results-count.js": {
      "types": "./dist/components/uvalib-results-count/uvalib-results-count.d.ts",
      "default": "./dist/components/uvalib-results-count/uvalib-results-count.js"
    },
    "./site-alerts.js": {
      "types": "./dist/components/site-alerts/site-alerts.d.ts",
      "default": "./dist/components/site-alerts/site-alerts.js"
    },
    "./site-hours-section.js": {
      "types": "./dist/components/site-hours-section/site-hours-section.d.ts",
      "default": "./dist/components/site-hours-section/site-hours-section.js"
    },
    "./library-weekly-hours.js": {
      "types": "./dist/components/library-weekly-hours/library-weekly-hours.d.ts",
      "default": "./dist/components/library-weekly-hours/library-weekly-hours.js"
    },
    "./library-hours-setup.js": {
      "types": "./dist/components/library-hours-setup/library-hours-setup.d.ts",
      "default": "./dist/components/library-hours-setup/library-hours-setup.js"
    },
    "./events-section.js": {
      "types": "./dist/components/events-section/events-section.d.ts",
      "default": "./dist/components/events-section/events-section.js"
    },
    "./bento-box.js": {
      "types": "./dist/components/bento-box/bento-box.d.ts",
      "default": "./dist/components/bento-box/bento-box.js"
    },
    "./uvalib-tabs.js": {
      "types": "./dist/components/uvalib-tabs/uvalib-tabs.d.ts",
      "default": "./dist/components/uvalib-tabs/uvalib-tabs.js"
    },
    "./uvalib-combobox.js": {
      "types": "./dist/components/uvalib-combobox/uvalib-combobox.d.ts",
      "default": "./dist/components/uvalib-combobox/uvalib-combobox.js"
    },
    "./uvalib-image-regions.js": {
      "types": "./dist/components/uvalib-image-regions/uvalib-image-regions.d.ts",
      "default": "./dist/components/uvalib-image-regions/uvalib-image-regions.js"
    },
    "./uvalib-map.js": {
      "types": "./dist/components/uvalib-map/uvalib-map.d.ts",
      "default": "./dist/components/uvalib-map/uvalib-map.js"
    },
    "./uvalib-filter-drawer.js": {
      "types": "./dist/components/uvalib-filter-drawer/uvalib-filter-drawer.d.ts",
      "default": "./dist/components/uvalib-filter-drawer/uvalib-filter-drawer.js"
    },
    "./uvalib-back-to-top.js": {
      "types": "./dist/components/uvalib-back-to-top/uvalib-back-to-top.d.ts",
      "default": "./dist/components/uvalib-back-to-top/uvalib-back-to-top.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./pagefind.css": "./dist/pagefind.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./manifest.json": "./dist-cdn/manifest.json",
    "./package.json": "./package.json",
    "./skills/*": "./skills/*"
  },
  "bin": {
    "uvalib-web-components": "bin/install-skill.mjs"
  },
  "files": [
    "dist",
    "dist-cdn",
    "skills",
    "bin",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "pnpm build && pnpm build:site --base /dist-site/ && pnpm test:node && pnpm test:browser",
    "test:node": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/report/node-reporter.mjs --test-reporter-destination=stdout test/*.test.mjs",
    "test:browser": "wtr --config web-test-runner.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && eslint . && prettier --check .",
    "build:npm": "tsc -p tsconfig.build.json && node scripts/emit-css.mjs dist && pnpm analyze && node scripts/gen-reference.mjs",
    "release": "node scripts/release.mjs",
    "build": "pnpm build:npm && pnpm build:cdn",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\" --outdir dist",
    "build:cdn": "vite build && node scripts/emit-css.mjs dist-cdn && node -e \"require('fs').copyFileSync('dist/custom-elements.json','dist-cdn/custom-elements.json')\" && node scripts/build-manifest.mjs && node scripts/copy-skills.mjs",
    "build:site": "vite build -c vite.site.config.ts",
    "start": "vite -c vite.site.config.ts --open /site/",
    "sync:main-nav": "node scripts/sync-main-nav.mjs",
    "lhci": "pnpm build && pnpm build:site && node --disable-warning=ExperimentalWarning scripts/lhci.mjs",
    "report": "node --disable-warning=ExperimentalWarning scripts/test-report.mjs"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lhci/cli": "0.15.1",
    "@open-wc/testing": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.0.2",
    "@web/test-runner-playwright": "^1.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "leaflet": "^1.9.4",
    "pagefind": "1.5.2",
    "pixelmatch": "^8.0.0",
    "playground-elements": "^0.21.2",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
